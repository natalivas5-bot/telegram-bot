def make_keyboard(options):
    return InlineKeyboardMarkup([
        [InlineKeyboardButton(text, callback_data=data)]
        for text, data in options
    ])


async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    users[update.effective_user.id] = {
        "step": 0,
        "scores": {k: 0 for k in stories}
    }
    keyboard = InlineKeyboardMarkup([[
        InlineKeyboardButton("✨ Начать тест", callback_data="start_test")
    ]])
    await update.message.reply_text(
        "🌙 <b>Добро пожаловать!</b>\n\n"
        "<b>Кем вы могли быть в прошлой жизни?</b>\n\n"
        "Или, точнее...\n\n"
        "<b>Какой опыт до сих пор влияет на вашу жизнь?</b>\n\n"
        "Этот тест поможет определить сценарий,\n"
        "который влияет на вашу жизнь сегодня.\n\n"
        "❗ Не думайте долго.\n"
        "Выбирайте первый отклик — он самый честный.",
        parse_mode="HTML",
        reply_markup=keyboard
    )


async def handle_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    user_id = query.from_user.id

    if user_id not in users:
        await query.message.reply_text("Напишите /start чтобы начать тест.")
        return

    data = query.data

    if data == "start_test":
        users[user_id]["step"] = 0
        q = questions[0]
        await query.message.edit_text(
            q["text"], parse_mode="HTML",
            reply_markup=make_keyboard(q["options"])
        )
        return

    user = users[user_id]
    step = user["step"]

    if step >= len(questions):
        return

    q = questions[step]
    if data in q["scores"]:
        for scenario, pts in q["scores"][data].items():
            user["scores"][scenario] += pts

    user["step"] += 1

    if user["step"] >= len(questions):
        await query.message.edit_text("🕯 Анализирую ответы...")
        await show_result(query.message, user_id)
    else:
        next_q = questions[user["step"]]
        await query.message.edit_text(
            next_q["text"], parse_mode="HTML",
            reply_markup=make_keyboard(next_q["options"])
        )


async def show_result(message, user_id):
    scores = users[user_id]["scores"]
    sorted_scores = sorted(scores.items(), key=lambda x: x[1], reverse=True)
    main = sorted_scores[0][0]
    second = sorted_scores[1][0]

    await message.reply_text(
        f"🌿 <b>Ваш основной сценарий</b>\n\n<b>{main}</b>\n\n"
        f"Также у вас проявляется\n\n<b>{second}</b>\n\n"
        "Именно эти две темы сильнее всего влияют на ваши решения.",
        parse_mode="HTML"
    )
    await message.reply_text(stories[main], parse_mode="HTML")
    await message.reply_text(
        "💭 На минуту остановитесь.\n\n"
        "Какая фраза задела вас сильнее всего?\n\n"
        "Ответьте себе.\n"
        "Именно с этого начинается настоящее исследование себя."
    )

    keyboard = InlineKeyboardMarkup([[
        InlineKeyboardButton("📂 Получить личное досье", url=CHANNEL)
    ]])
    await message.reply_text(
        "🤍 Я подготовила для вас подарок.\n\n"
        "📂 <b>Личное досье</b>\n\n"
        "✨ подробное описание вашего сценария\n"
        "✨ почему он проявляется в отношениях и деньгах\n"
        "✨ вопросы для самостоятельного исследования\n"
        "✨ медитативную практику\n\n"
        "🎁 Всё это бесплатно. 👇",
        parse_mode="HTML",
        reply_markup=keyboard
    )
    await message.reply_text(
        "Спасибо, что прошли этот тест. 🤍\n\n"
        "Любой сценарий — это не приговор.\n\n"
        "Это история, которую можно понять\n"
        "и постепенно изменить.\n\n"
        "До встречи в Telegram 🌿"
    )


app = ApplicationBuilder().token(TOKEN).build()
app.add_handler(CommandHandler("start", start))
app.add_handler(CallbackQueryHandler(handle_callback))

print("Бот запущен")
app.run_polling()